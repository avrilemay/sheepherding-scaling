    <experiment name="1-fail" repetitions="30" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition>done? or ticks &gt;= 10000</exitCondition>
      <metrics>
        <metric>ticks</metric>
        <metric>done?</metric>
        <metric>current-phase</metric>
        <metric>ticks-to-success</metric>
        <metric>holding-time</metric>
        <metric>sheep-in-zone</metric>
        <metric>sheep-captured-count</metric>
        <metric>dogs-distance</metric>
        <metric>lost-sheep</metric>
        <metric>flock-spreadness</metric>
        <metric>mean-spreadness</metric>
