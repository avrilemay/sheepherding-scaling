<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[breed [sheep a-sheep] ; sheep agents
breed [dogs a-dog] ; herding dog agents
breed [centroids a-centroid] ; only visual marker for flock center

globals [phase done? ticks-to-success holding-start-tick sheep-captured gate-x gate-min-y gate-max-y spreadness-sum spreadness-count] 

sheep-own [speed state prev-x prev-y stuck-counter] ; individual sheep properties
dogs-own [mode target-sheep dist-traveled prev-x prev-y stuck-counter patrol-angle] ; individual dog properties

; REPORTERS 
to-report containment-radius
  let r-raw 2.5 * sqrt nb-sheep ; radius proportional to flock size
  let r-max min list (max-pxcor - 8) (max-pycor - 8) ; cap: don't exceed world bounds - 8
  let r-min 23 ;  floor: minimum radius to avoid too small 
  report max list r-min (min list r-raw r-max) ; clamp between r-min and r-max
end
to-report containment-center-x report 0 end ; x coordinate of target zone
to-report containment-center-y report 0 end ; y coordinate of target zone
to-report gate-half-size report 3 end ; half width of exit gate
to-report holding-duration report 800 end ; containment time
  
; sheeps behavior
to-report R-fleeing-dog report 14 end ; radius where sheep flee from dogs
; to-report R-repulsion report 2 end ; personal space between sheep
to-report R-vigilance report R-fleeing-dog * 1.8 end ; wider radius for fear contagion
to-report speed-fleeing report 0.3 end ; speed when scared
to-report speed-grazing report 0.01 end ; v slow speed when calm
to-report stress-repulsion-mult report 0.5 end ; repulsion is less when stressed
to-report max-turn report 40 end ; max degrees per tick
to-report n-topological report 7 end ; number of neighbors to consider
to-report fear-contagion-threshold report 0.3 end ; proportion of fleeing neighbors to trigger panic
to-report sheep-stuck-threshold report 0.2 end ; min distance to not be stuck
to-report sheep-stuck-ticks report 15 end ; ticks before unstuck behavior

; sheep force weights
to-report W-flee-strength report 3.5 end ; flee force from dogs ++
to-report W-neigh-fleeing-cohesion report 1.5 end ; attraction to nearby neighbors
to-report W-neigh-grazing-cohesion report 0.5 end ; weak cohesion when grazing
to-report W-global-cohesion report 0.75 end ; attraction to flock center
to-report W-sheep-repulsion report 1.5 end ; avoid crowding
to-report W-flee-near-gate report 0.5 end ; reduced flee near exit
to-report W-alignment report 0.3 end ; match neighbor headings when grazing only
to-report grazing-persistence report 0.5 end ; keep same direction when grazing only

; density gradient parameters
to-report nb-sectors report 8 end ; number of angular sectors for density scan
to-report vision-range report 30 end ; how far sheep can perceive density

; dog behavior
to-report dog-speed report 1.0 end ; movement speed
to-report dog-behind-distance report 9 end ; distance behind flock
to-report dog-push-distance report 9 end ; distance for pushing
to-report dog-formation-spread report 90 end ; spacing between multiple dogs
to-report dog-patrol-radius
  ifelse containment-radius < 25  
    [ report containment-radius + 8 ] ; bigger when containment is small 
    [ report containment-radius + 5 ] ; to avoid scaring sheep
end
to-report R-repulsion-dogs report 5 end ; dog-dog avoidance radius
to-report dog-repulsion-weight report 0.8 end ; strength of dog repulsion
to-report dog-stuck-threshold report 0.3 end ; min distance for stuck detection
to-report dog-stuck-ticks report 25 end ; ticks before unstuck
to-report dog-approach-curve-radius report 25 end ; radius for curved approach
to-report dog-approach-curve-strength report 9.0 end ; strength of curve
to-report dog-proximity-slowdown report 2.5 end ; slowdown factor near sheep
to-report dog-retreat-distance report 10 end ; backup distance when too close
to-report flock-fragmentation-threshold report 0.1 end ; threshold for split flock

; wall avoidance
to-report wall-avoidance-radius report 8 end ; distance from walls to avoid (sheep)
to-report wall-avoidance-strength report 5 end ; force strength (sheep)

; thresholds
to-report lost-threshold report 4 * sqrt sqrt count sheep end ; distance to be lost
to-report levy-step [min-step max-step] report min list max-step (min-step * exp random-float 5) end ; levy walk step
  ; check if in zone :
to-report in-containment-zone? report distancexy containment-center-x containment-center-y <= containment-radius end 

  
to-report mean-spreadness 
  if spreadness-count = 0 [report 0] ; avoid division by zero
  report spreadness-sum / spreadness-count ; time-averaged flock spread
end
  
; SETUP 
to setup
  clear-all ; reset everything
  ; initialize globals
  set done? false  set ticks-to-success -1  set holding-start-tick -1  set sheep-captured 0  set phase "collecting" 
  ; position gate at right edge
  set gate-x max-pxcor  set gate-min-y (- gate-half-size)  set gate-max-y gate-half-size 
  create-dogs nb-dogs [setup-one-dog] ; spawn dogs
  create-sheep nb-sheep [setup-one-sheep] ; spawn sheep
  setup-patches ; draw zones
  set spreadness-sum 0 ; initialize spread accumulator
  set spreadness-count 0 ; initialize spread tick counter
  reset-ticks ; start time
end

to setup-one-sheep
  set color white  set shape "sheep"  set size 1  set heading random 360 ; appearance and direction
  set speed speed-grazing  set state "grazing"  set stuck-counter 0 ; initial behavior state
  place-anywhere ; spawn 
  set prev-x xcor  set prev-y ycor ; store position for stuck check
end

to place-anywhere
  let valid? false
  while [not valid?] [ 
    let try-x (min-pxcor + 2 + random (world-width - 4)) ; random x with buffer
    let try-y (min-pycor + 2 + random (world-height - 4)) ; random y with buffer
    setxy try-x try-y ; place sheep at position
    set valid? (not any? dogs in-radius 5) ; ensure no dog nearby
  ]
end

to setup-one-dog
  ; get dog index ; column : 0, 1, 2 ; line: 0, 0, 0, 1, 1, 1,
  let i (who - min [who] of dogs) ; dog index starting from 0
  setxy (min-pxcor + 5 + (i mod 3) * 3) (max-pycor - 5 - floor (i / 3) * 3) ; grid position
  set color brown  set shape "wolf"  set size 1.6  set heading random 360 ; appearance
  set mode "targeting"  set target-sheep nobody  set dist-traveled 0 ; initial phase
  ; space patrol angles
  set prev-x xcor  set prev-y ycor  set stuck-counter 0  set patrol-angle (360 * i / nb-dogs) 
end

to setup-patches
  ask patches [set pcolor 52] ; base color green for grass
  ask patches [ ; draw containment boundary
    let d distancexy containment-center-x containment-center-y ; distance from center
    if d <= containment-radius and d > containment-radius - 0.5 [set pcolor 55] ; ring for boundary
  ]
  ask patch containment-center-x containment-center-y [set pcolor red] ; mark center
  ask patches with [pxcor = max-pxcor] [ ; draw gate on right edge
  ; gate opening vs wall
    ifelse (pycor >= gate-min-y and pycor <= gate-max-y) [set pcolor 55] [set pcolor gray] 
  ]
end

; MAIN LOOP
to go
  if done? [stop] ; stop if simulation complete
  if not any? sheep [check-success stop] ; check if all sheep gone
  update-phase ; manage phase transitions
  ask dogs [move-dog] ; dogs move first
  ask sheep [move-sheep] ; then sheep react
  check-success ; check completion conditions
  set spreadness-sum (spreadness-sum + flock-spreadness) ; accumulate spread over time
  set spreadness-count (spreadness-count + 1) ; increment tick counter for average
  tick ; advance time
end

to update-phase
  if phase = "collecting" [ ; gathering phase
    let fcx mean [xcor] of sheep  let fcy mean [ycor] of sheep ; global flock center
    ; check compactness
    let flock-centered? (distance-between fcx fcy containment-center-x containment-center-y < containment-radius * 0.15) 
    let flock-compact? (lost-sheep = 0)  ; are all the sheep compacted 
    if all? sheep [in-containment-zone?] and flock-centered? and flock-compact? [ ; all sheep in zone & centered & compact
      set phase "holding"  set holding-start-tick ticks ; switch to holding
      let i 0 ; dog counter
      ask dogs [set patrol-angle (360 * i / count dogs) set mode "patrolling" set i (i + 1)] ; assign patrol positions
    ]
  ]
  if phase = "holding" [ ; maintaining containment
    let escape-ratio (count sheep with [not in-containment-zone?]) / count sheep ; proportion escaped
    let tolerance ifelse-value (nb-dogs = 1) [0.10] [0.05] ; little bit of leeway
    if escape-ratio > tolerance [ ; too many escaped
      ; restart collection :
      set phase "collecting"  set holding-start-tick -1  ask dogs [set mode "targeting"] 
    ] 
    ; held long enough :
    if holding-start-tick != -1 and (ticks - holding-start-tick) >= holding-duration [
      ; we stop the holding counter when it's over
      set phase "exiting"  set holding-start-tick -1 ask dogs [set mode "driving"] ; start driving to exit
    ]
  ]
  
end


; SHEEP BEHAVIOR 

to move-sheep
  update-sheep-state ; determine if fleeing or grazing
  let dir compute-sheep-direction ; calculate movement direction
  let dir-x first dir  let dir-y last dir ; extract x and y components

  
  if state = "grazing" [ ; additional grazing behaviors
    set dir-x (dir-x + sin heading * grazing-persistence) ; tendency to continue straight
    set dir-y (dir-y + cos heading * grazing-persistence) ; in current direction
    ; selecting topological neighbors for alignement 
    let all-others other sheep in-radius vision-range
    if n-topological > 0 [
      if any? all-others [
        let nearby-sheep min-n-of (min list n-topological (count all-others)) all-others [distance myself]
        if any? nearby-sheep [ ; if has neighbors
          let avg-sin mean [sin heading] of nearby-sheep ; average x component
          let avg-cos mean [cos heading] of nearby-sheep ; average y component
          if avg-sin != 0 or avg-cos != 0 [ ; if neighbors have direction
            let avg-heading atan avg-sin avg-cos ; compute average heading
            set dir-x (dir-x + sin avg-heading * W-alignment) ; align with neighbors
            set dir-y (dir-y + cos avg-heading * W-alignment) ; weighted alignment
        ]
        ]
      ]
    ]
  ]
    
  if random 100 < 2 [ ; x% chance to add "noise" to the direction 
    set dir-x (dir-x + random-float 0.4 - 0.2) ; random float between 0.0 and 0.4, then centered: 
    set dir-y (dir-y + random-float 0.4 - 0.2) ] ; between -0.2 and 0.2
  
  
  if dir-x != 0 or dir-y != 0 [turn-towards atan dir-x dir-y max-turn] ; turn toward target heading
  ; levy walk when grazing or constant speed when fleeing
  let spd ifelse-value (state = "grazing") [levy-step speed-grazing 0.2] [speed] 
  move-sheep-step spd ; execute movement
  handle-stuck sheep-stuck-threshold sheep-stuck-ticks 1.5 "random" ; check and resolve stuck
end



to update-sheep-state
  let any-dog-near? any? dogs in-radius R-fleeing-dog ; check close dogs
  let any-dog-vigilance? any? dogs in-radius R-vigilance ; check wider radius
  ; flee if dog close or neighbors fleeing
  ifelse any-dog-near? or (any-dog-vigilance? and check-neighbor-fear-contagion) [ 
    set state "fleeing"  set speed speed-fleeing  set color pink ; switch to fleeing
  ] [
    set state "grazing"  set speed speed-grazing  set color white ; switch to grazing
  ]
end


to-report check-neighbor-fear-contagion
  if n-topological = 0 [report false]
  let all-others other sheep in-radius vision-range ; all sheep, no radius constraint
  if not any? all-others [report false] ; no other sheep exist
  ; select N closest neighbors, regardless of distance
  let neighborss min-n-of (min list n-topological (count all-others)) all-others [distance myself]
  if not any? neighborss [report false] ; safety check (should never happen)
  ; check if enough fleeing
  report (count neighborss with [state = "fleeing"] / count neighborss) >= fear-contagion-threshold 
end


to-report compute-sheep-direction
  let dir-x 0  let dir-y 0 ; initialize force vector
  
  ; 1. flee from dogs
  let dogs-nearby dogs in-radius R-fleeing-dog ; get threatening dogs
  if any? dogs-nearby [ ; if dogs present
    ; weaker near gate:
    let flee-strength ifelse-value (phase = "exiting" and near-gate?) [W-flee-near-gate] [W-flee-strength] 
    ask dogs-nearby [ ; for each threatening dog
      let d distance myself ; distance to this dog
      if d > 0.01 [ ; avoid division by zero
        let force (flee-strength * (R-fleeing-dog - d) / d) ; inverse distance force
        let angle ([towards myself] of myself + 180) 
        set dir-x (dir-x + force * sin angle)  set dir-y (dir-y + force * cos angle) ; add to total force
      ]
    ]
  ]
 
  ; 2. repulsion from other sheep
  let stress-mult ifelse-value (state = "fleeing") [stress-repulsion-mult] [1] ; reduce repulsion when stressed
  ask other sheep in-radius R-repulsion [ ; for each too-close sheep
    let d distance myself ; distance to neighbor
    if d > 0.01 [ ; avoid division by zero
      ; repulsion force depending on if the sheep is fleeing or grazing
      let force ((R-repulsion - d) / d * W-sheep-repulsion * stress-mult) 
      ; myself - neighbor = direction from neighbor to myself 
      set dir-x (dir-x + ([xcor] of myself - xcor) * force)  ; moving away 
      set dir-y (dir-y + ([ycor] of myself - ycor) * force) ; from neighbor
    ]
  ]
  
  ; 3. cohesion
  let cohesion-result compute-cohesion ; get cohesion vector
  ; add to total
  set dir-x (dir-x + first cohesion-result)  
  set dir-y (dir-y + last cohesion-result) 
  
  ; 4. gate attraction
  if phase = "exiting" [ ; only during exit phase
    let gate-dir compute-gate-attraction ; calculate gate pull
    set dir-x (dir-x + first gate-dir)  ; add to total
    set dir-y (dir-y + last gate-dir) 
  ]
  
  ; 5. wall avoidance - - compute wall repulsion :
  let wall-dir (compute-wall-avoidance-generic wall-avoidance-radius wall-avoidance-strength true)
  set dir-x (dir-x + first wall-dir)  
  set dir-y (dir-y + last wall-dir) ; add to total
  
  report list dir-x dir-y ; return final direction vector
end



to-report compute-cohesion
  let dir-x 0  let dir-y 0 ; initialize cohesion force
  
  if n-topological > 0 [
    let visible-others other sheep in-radius vision-range ; only sheep within vision range
    let neigh min-n-of (min list n-topological (count visible-others)) visible-others [distance myself] ; get n closest visible neighbors 
    ; Local Mass Center LCM
    if any? neigh [ ; if has neighbors
      let cx mean [xcor] of neigh  let cy mean [ycor] of neigh ; center of neighbors
      let dist-to-neigh distancexy cx cy ; distance to neighbor center
      if dist-to-neigh > 0.01 [ ; avoid division by zero
        let angle towardsxy cx cy ; direction to neighbors
        if state = "fleeing" and dist-to-neigh > R-repulsion [ ; strong cohesion when fleeing
          set dir-x (dir-x + W-neigh-fleeing-cohesion * sin angle)  set dir-y (dir-y + W-neigh-fleeing-cohesion * cos angle) ; pull toward neighbors
        ]
        if state = "grazing" and dist-to-neigh > (R-repulsion * 2) [ ; weak cohesion when grazing
          set dir-x (dir-x + W-neigh-grazing-cohesion * sin angle)  set dir-y (dir-y + W-neigh-grazing-cohesion * cos angle) ; gentle pull
        ]
      ]
    ]
  ]
  
  ; Global cohesion: either density gradient or classic centroid depending on switch
  if state = "fleeing" and count sheep > 1 [
    ifelse use-density-gradient? [
      ; Density gradient: go toward densest visible sector
      let best-dir densest-sector-direction ; scan sectors for densest area
      if best-dir != -1 [ ; if a direction was found
        set dir-x (dir-x + W-global-cohesion * sin best-dir) ; pull toward densest sector
        set dir-y (dir-y + W-global-cohesion * cos best-dir) ; weighted by global cohesion
      ]
    ] [
      ; Classic centroid: go toward global center of mass (original behavior)
      let global-cx mean [xcor] of sheep  let global-cy mean [ycor] of sheep ; whole flock center
      let dist-to-global distancexy global-cx global-cy ; distance to flock
      if dist-to-global > 0.01 [ ; avoid division by zero
        let angle towardsxy global-cx global-cy ; direction to flock
        ; pull toward flock
        set dir-x (dir-x + W-global-cohesion * sin angle)  set dir-y (dir-y + W-global-cohesion * cos angle) 
      ]
    ]
  ]
  report list dir-x dir-y ; return cohesion vector
end

to-report densest-sector-direction
  let sector-size (360 / nb-sectors) ; degrees per sector
  let visible other sheep in-radius vision-range ; sheep within sight
  if not any? visible [report -1] ; no visible sheep

  ; pre-compute angles from me to each visible sheep
  let angles map [s -> ifelse-value (distance s > 0.01) [towards s] [-1]] sort visible
  set angles filter [a -> a != -1] angles ; remove invalid angles

  ; count sheep in each sector and find densest
  let best-sector -1 ; index of densest sector
  let max-count 0 ; highest sheep count found
  let i 0 ; sector counter
  repeat nb-sectors [
    let sector-start (i * sector-size) ; sector lower bound
    let sector-end (sector-start + sector-size) ; sector upper bound
    let c length filter [a -> angle-in-sector? a sector-start sector-end] angles ; count sheep in sector
    if c > max-count [ ; new densest sector found
      set max-count c
      set best-sector i
    ]
    set i (i + 1) ; next sector
  ]

  if best-sector = -1 [report -1] ; no sheep in any sector
  report (best-sector * sector-size + sector-size / 2) ; return angle to center of densest sector
end

; check if an angle falls within a sector (handles 360° wrap-around)
to-report angle-in-sector? [a start-a end-a]
  set a a mod 360
  set start-a start-a mod 360
  set end-a end-a mod 360
  ifelse start-a < end-a
    [report a >= start-a and a < end-a]
    [report a >= start-a or a < end-a] ; wrap-around case
end


to-report compute-gate-attraction
  let dir-x 0  let dir-y 0 ; initialize gate force
  let intensity ifelse-value (any? dogs in-radius R-fleeing-dog) [1.5] [0.3] ; stronger with dogs nearby
  if near-gate? [set dir-x (dir-x + 1.5 * intensity)] ; pull right when near gate
  if (xcor >= gate-x - 5 and ycor >= gate-min-y and ycor <= gate-max-y) [set dir-x (dir-x + 5.0)] ; strong pull at gate
  if xcor >= gate-x - 10 [ ; funnel zone
    let funnel-strength (0.6 * intensity) ; base funnel force
    let proximity-factor (2 - (gate-x - xcor) / 5) ; stronger when closer to gate
     ; push down if too high:
    if ycor > gate-max-y [set dir-y (dir-y - funnel-strength * proximity-factor * (1 + (ycor - gate-max-y) * 0.3))]
    ; push up if too low:
    if ycor < gate-min-y [set dir-y (dir-y + funnel-strength * proximity-factor * (1 + (gate-min-y - ycor) * 0.3))] 
  ]
  report list dir-x dir-y ; return gate attraction vector
end

to-report near-gate?
  report xcor >= gate-x - 3 and ycor >= gate-min-y - 5 and ycor <= gate-max-y + 5 ; check if in gate area
end

to move-sheep-step [dist]
if phase != "exiting" [fd dist] ; normal movement if not exiting
if phase = "exiting" [ ; small steps for collision checking
  repeat ceiling (dist / 0.25) [
    let ahead patch-ahead 0.25 ; check next patch
    if ahead != nobody and [is-wall?] of ahead [rt 90 + random 180 stop] ; bounce off walls
    fd 0.25 ; move forward
    if xcor >= gate-x and ycor >= gate-min-y and ycor <= gate-max-y [ ; check if through gate
      set sheep-captured (sheep-captured + 1) die stop ; count and remove
    ]
  ]
]
end

; DOG BEHAVIOR 

to move-dog
  if not any? sheep [stop] ; nothing to herd
  let flock-center-x mean [xcor] of sheep  
  let flock-center-y mean [ycor] of sheep ; compute flock center
  let current-speed dog-speed ; default speed
  
  ; 1. flock fragmentation retreat - back off if flock is splitting
  let dispersion-ratio (lost-sheep / count sheep)
  let dist-to-flock (distancexy flock-center-x flock-center-y)
  
  if dispersion-ratio > flock-fragmentation-threshold and (mode = "driving" or mode = "targeting") and dist-to-flock < dog-push-distance * 1.1 [
    set color red ; warning color
    ; retreat away from flock
    let retreat-x (xcor - flock-center-x) ; vector from flock center
    let retreat-y (ycor - flock-center-y) ; to dog
    let retreat-mag sqrt (retreat-x ^ 2 + retreat-y ^ 2) ;  magnitude of the vector
    if retreat-mag > 0.1 [ ; avoid 0 division
      ; ; face away from flock center
      facexy (xcor + retreat-x / retreat-mag * dog-retreat-distance) (ycor + retreat-y / retreat-mag * dog-retreat-distance)
      fd current-speed * 0.5 ; half speed to go gently
      set dist-traveled (dist-traveled + current-speed * 0.5)
    ]
    stop ; skip normal movement
  ]
  
  ; 2. get dog-dog repulsion
  let repulsion compute-dog-repulsion 
  let rep-x first repulsion  
  let rep-y last repulsion ; extract components
  

  let desired list 0 0 ; initialize desired direction
  if mode = "targeting" [ ; collecting takes priority regardless of phase
    set color orange
    set desired move-dog-targeting flock-center-x flock-center-y
  ]
  if mode = "patrolling" [ ; only during holding phase
    set color green
    set desired move-dog-patrolling
  ]
  if mode = "driving" [ ; driving toward gate or toward containment
    set color brown
    set desired move-dog-driving flock-center-x flock-center-y
  ]
  
  let desired-x first desired  
  let desired-y last desired ; extract components
  
  ; 3. wall avoidance
  let wall-dir (compute-wall-avoidance-generic 3 1 false) ; compute wall force
  set desired-x (desired-x + first wall-dir)  
  set desired-y (desired-y + last wall-dir) ; add to desired
  
  ; 4. avoid getting too close to sheep (not during patrolling)
  if mode != "patrolling" [ ; when actively herding
    ask sheep in-radius (R-fleeing-dog * 0.5) [ ; sheep too close
      let d distance myself ; distance to sheep
      if d > 0.1 [ ; avoid division by zero
        let push (1 * (R-fleeing-dog * 0.5 - d) / d) ; repulsion force stronger when closer
        set desired-x (desired-x + ([xcor] of myself - xcor) * push)  
        set desired-y (desired-y + ([ycor] of myself - ycor) * push) ; push away
      ]
    ]
  ]
  
  let final-x (desired-x + rep-x * dog-repulsion-weight) ; combine desired and repulsion
  let final-y (desired-y + rep-y * dog-repulsion-weight) ; weighted sum
  
  ; 5. hard constraint: patrolling dogs stay on perimeter and don't go inside
  if mode = "patrolling" [ ; when patrolling
    let my-dist-to-center (distancexy containment-center-x containment-center-y) ; how far from zone center
    let min-patrol-dist (containment-radius + 1) ; just outside containment
    if my-dist-to-center < min-patrol-dist [ ; drifted too close to center
      let away-x (xcor - containment-center-x)  
      let away-y (ycor - containment-center-y) ; direction pointing outward from center
      let away-mag sqrt (away-x ^ 2 + away-y ^ 2) ; length of this vector
      if away-mag > 0.01 [ ; avoid division by zero
        let push-strength 5.0 * (min-patrol-dist - my-dist-to-center) ; stronger the closer to center
        ; completely override all other forces to push back out
        set final-x (away-x / away-mag * push-strength)  
        set final-y (away-y / away-mag * push-strength)
      ]
    ]
  ]
  
  if final-x != 0 or final-y != 0 [facexy (xcor + final-x) (ycor + final-y)] ; turn toward target
  
  ; 6. speed adjustments - two independent slowdown mechanisms
  let move-dist current-speed ; start with base speed (1)
  
  ; slowdown 1: avoid colliding with other dogs
  if any? other dogs [ ; check if other dogs exist
    let min-dist min [distance myself] of other dogs ; find closest dog
    if min-dist < 5 [ ; within collision risk zone
      ; gradual slowdown: at dist=0 -> 50% speed, at dist=4 -> 100% speed
      set move-dist (move-dist * (0.5 + 0.5 * min-dist / 4))
    ]
  ]
  
  ; slowdown 2: avoid going into the flock
  set dist-to-flock distancexy flock-center-x flock-center-y ; recalculate distance to flock center
  if dist-to-flock < dog-push-distance * dog-proximity-slowdown [ ; within proximity zone (13 × 1.3 = 16.9)
    ; gradual slowdown: at dist=0 -> 20% speed, at dist -> 100% speed, capped at minimum 20%
    set move-dist (move-dist * max list 0.2 (dist-to-flock / (dog-push-distance * dog-proximity-slowdown)))
  ]
  
  fd move-dist ; move forward with adjusted speed (both slowdowns can add)
  set dist-traveled (dist-traveled + move-dist) 
  handle-stuck dog-stuck-threshold dog-stuck-ticks 3 "toward-flock" ; detect stuck, escape toward flock if needed
end




to-report move-dog-targeting [fcx fcy]
  
  let dir-x 0  let dir-y 0 ; initialize movement vector
  let outliers sheep with [distancexy fcx fcy > lost-threshold] ; sheep too far from flock center
  ; trying to find a target
  ifelse lost-sheep > 0 [ ; flock is dispersed
    let taken [target-sheep] of other dogs with [target-sheep != nobody] ; sheep already targeted by other dogs
    let available outliers with [not member? self taken] ; untargeted outliers
    set target-sheep nobody ; clear current target
    if any? available [set target-sheep min-one-of available [distance myself]] ; pick closest available outlier
    
    ; 1. if target found -> aim behind it relative to flock center
    if target-sheep != nobody [ ; if we have a target
      let tx [xcor] of target-sheep  
      let ty [ycor] of target-sheep ; target position
      let d (distance-between tx ty fcx fcy) ; target distance from flock center
      if d > 0.001 [ ; avoid division by zero
        let behind-x (tx + dog-behind-distance * (tx - fcx) / d) ; position behind target relative to flock
        let behind-y (ty + dog-behind-distance * (ty - fcy) / d) ; normalized vector
        let curve (compute-curved-approach behind-x behind-y target-sheep) ; curved path to avoid rushing straight at sheep
        set dir-x first curve  set dir-y last curve ; extract components
      ]
    ] ; if no target free: do not do anything (avoid blowing up the flock) --> STAY IDLE
  ] 
  [ ; flock is compact -> position in formation behind flock
    set target-sheep nobody ; no individual target needed
    let target-x ifelse-value (phase = "exiting") [gate-x - 5] [containment-center-x]
    let target-y ifelse-value (phase = "exiting") [0] [containment-center-y]
    let d (distance-between fcx fcy target-x target-y)
    if d > 1 [ ; if flock not already at target
      let angle atan (target-x - fcx) (target-y - fcy)
      let my-index position self (sort dogs) ; get index based on who
      let total count dogs ; total dog count for formation
      let offset (dog-formation-spread * (my-index - (total - 1) / 2) / max list 1 (total - 1)) ; spread in arc
      let behind-angle (angle + 180 + offset) ; position behind flock with offset
      set dir-x (fcx + dog-push-distance * sin behind-angle - xcor) ; compute formation position
      set dir-y (fcy + dog-push-distance * cos behind-angle - ycor) ; relative to flock
    ]
  ]
  report list dir-x dir-y ; return movement vector
end

to-report move-dog-patrolling
  let dir-x 0  let dir-y 0 ; initialize movement vector
  
  let patrolling-dogs sort dogs with [mode = "patrolling"] ; get all patrolling dogs
  let my-index position self patrolling-dogs ; find my position in list
  if my-index = false [set my-index 0] ; fallback if not found
  let total-patrolling max list 1 (length patrolling-dogs) ; number of patrolling dogs
  let my-current-angle atan (xcor - containment-center-x) (ycor - containment-center-y) ; my angle from center
  let target-angle 0 ; where to patrol
  
  ifelse total-patrolling = 1 [ ; single dog patrols whole perimeter
    let most-threatening-sheep max-one-of sheep [distancexy containment-center-x containment-center-y] ; sheep closest to edge
    ifelse most-threatening-sheep != nobody [ ; if found
      let sx [xcor] of most-threatening-sheep  let sy [ycor] of most-threatening-sheep ; sheep position
      set target-angle atan (sx - containment-center-x) (sy - containment-center-y) ; patrol toward threat
    ] [set target-angle my-current-angle] ; stay in place if no threats
  ] [
    let section-size (360 / total-patrolling) ; divide perimeter into sectors
    let my-start-angle (my-index * section-size) ; start of my sector
    let my-end-angle (my-start-angle + section-size) ; end of my sector
    let my-center-angle (my-start-angle + section-size / 2) ; center of my sector
    
    let sheep-list [] ; sheep in my sector
    foreach sort sheep [s -> ; for each sheep
      let sx [xcor] of s  let sy [ycor] of s ; sheep position
      let sheep-angle-from-center atan (sx - containment-center-x) (sy - containment-center-y) ; angle from center
      if angle-in-range sheep-angle-from-center my-start-angle my-end-angle [ ; if in my sector
        set sheep-list lput s sheep-list ; add to list
      ]
    ]
    let sheep-in-my-sector turtle-set sheep-list ; convert to agentset
    
    ifelse any? sheep-in-my-sector [ ; if sheep in my sector
      let most-threatening max-one-of sheep-in-my-sector [distancexy containment-center-x containment-center-y] ; closest to edge
      let sx [xcor] of most-threatening  let sy [ycor] of most-threatening ; threat position
      ; constrain to sector :
      set target-angle clamp-angle (atan (sx - containment-center-x) (sy - containment-center-y)) my-start-angle my-end-angle 
    ] [set target-angle my-center-angle] ; default to sector center
  ]
  
  let angle-diff subtract-headings target-angle my-current-angle ; angular distance to target
  ifelse abs angle-diff > 5 [ ; if not at target angle
    let step-angle 8 ; movement step size
    let next-angle my-current-angle + (ifelse-value (angle-diff > 0) [step-angle] [0 - step-angle]) ; step toward target
    set dir-x (containment-center-x + dog-patrol-radius * sin next-angle - xcor) ; position on patrol circle
    set dir-y (containment-center-y + dog-patrol-radius * cos next-angle - ycor) ; at next angle
  ] [
    set dir-x (containment-center-x + dog-patrol-radius * sin target-angle - xcor) ; position on patrol circle
    set dir-y (containment-center-y + dog-patrol-radius * cos target-angle - ycor) ; at target angle
  ]
  
  let my-dist-to-center distancexy containment-center-x containment-center-y ; distance from center
  if my-dist-to-center < dog-patrol-radius - 1 [ ; if too close to center
    let outward-x (xcor - containment-center-x)  let outward-y (ycor - containment-center-y) ; vector away from center
    let outward-mag sqrt (outward-x ^ 2 + outward-y ^ 2) ; magnitude
    if outward-mag > 0.01 [ ; avoid division by zero
      set dir-x (dir-x + outward-x / outward-mag * 2)  set dir-y (dir-y + outward-y / outward-mag * 2) ; push outward
    ]
  ]
  report list dir-x dir-y ; return movement vector
end



to-report move-dog-driving [fcx fcy]
  let dir-x 0  let dir-y 0 ; initialize movement vector

  let drive-x gate-x - 5  let drive-y 0 ; target position near gate
  let d distance-between fcx fcy drive-x drive-y ; distance to target
  if d > 1 [ ; if not at target
    let angle atan (drive-x - fcx) (drive-y - fcy) ; direction to push flock
    let my-index position self (sort dogs)  let total count dogs ; formation position
    let offset (dog-formation-spread * (my-index - (total - 1) / 2) / max list 1 (total - 1)) ; spread in arc
    let behind-angle (angle + 180 + offset) ; position behind flock
    set dir-x (fcx + dog-push-distance * sin behind-angle - xcor) ; compute target position
    set dir-y (fcy + dog-push-distance * cos behind-angle - ycor) ; in formation
  ]
  report list dir-x dir-y ; return movement vector
end



to-report compute-dog-repulsion
  let rep-x 0  let rep-y 0 ; initialize repulsion vector
  ask other dogs in-radius R-repulsion-dogs [ ; for each nearby dog
    let d distance myself ; distance to other dog
    if d >= 0.1 [ ; avoid division by zero
      let force ((R-repulsion-dogs - d) / d) ; inverse distance force
      set rep-x (rep-x + ([xcor] of myself - xcor) * force) ; push away on x
      set rep-y (rep-y + ([ycor] of myself - ycor) * force) ; push away on y
    ]
  ]
  report list rep-x rep-y ; return repulsion vector
end


to-report compute-curved-approach [dest-x dest-y avoid-object]
  let goal-dx (dest-x - xcor)  let goal-dy (dest-y - ycor) ; direct path to goal
  let avoid-dx 0  let avoid-dy 0 ; avoidance component
  if avoid-object != nobody [ ; if avoiding something
    let d distance avoid-object ; distance to object
    if d < dog-approach-curve-radius and d > 0.1 [ ; within curve radius
      set avoid-dx (xcor - [xcor] of avoid-object)  set avoid-dy (ycor - [ycor] of avoid-object) ; vector away from object
      let avoid-mag sqrt (avoid-dx ^ 2 + avoid-dy ^ 2) ; magnitude
      if avoid-mag > 0.01 [ ; avoid division by zero
        ; strength based on distance
        let curve-strength (dog-approach-curve-strength * (dog-approach-curve-radius - d) / dog-approach-curve-radius) 
         ; normalize and scale
        set avoid-dx (avoid-dx / avoid-mag * curve-strength)  set avoid-dy (avoid-dy / avoid-mag * curve-strength)
      ]
    ]
  ]
  report list (goal-dx + avoid-dx) (goal-dy + avoid-dy) ; combine goal and avoidance
end


; UTILITIES 

to-report compute-wall-avoidance-generic [radius strength exit-aware?]
  let dir-x 0  let dir-y 0 ; initialize avoidance vector
  let d-left (xcor - min-pxcor)  let d-right (max-pxcor - xcor) ; distance to left and right walls
  let d-bottom (ycor - min-pycor)  let d-top (max-pycor - ycor) ; distance to bottom and top walls
  
  if d-left < radius [set dir-x (dir-x + strength / (d-left ^ 2 + 0.01))] ; push away from left wall
  if d-bottom < radius [set dir-y (dir-y + strength / (d-bottom ^ 2 + 0.01))] ; push away from bottom wall
  if d-top < radius [set dir-y (dir-y - strength / (d-top ^ 2 + 0.01))] ; push away from top wall
  
  if d-right < radius [ ; near right wall
    let dominated-by-gate? (exit-aware? and phase = "exiting" and ycor >= gate-min-y - 3 and ycor <= gate-max-y + 3) ; check if near gate
    if not dominated-by-gate? [ ; not near gate opening
      set dir-x (dir-x - strength / (d-right ^ 2 + 0.01)) ; push away from wall
      if exit-aware? and phase = "exiting" [ ; if exiting phase
        let gate-center-y ((gate-min-y + gate-max-y) / 2) ; vertical center of gate
        set dir-y (dir-y + 0.8 * (gate-center-y - ycor) / (abs(gate-center-y - ycor) + 1)) ; guide toward gate center
      ]
    ]
  ]
  report list dir-x dir-y ; return avoidance vector
end

to handle-stuck [threshold max-stuck-ticks escape-dist escape-behavior]
  let dist-moved distancexy prev-x prev-y ; distance moved since last tick
  ifelse dist-moved < threshold [ ; if barely moved
    set stuck-counter (stuck-counter + 1) ; increment stuck counter
    if stuck-counter > max-stuck-ticks [ ; stuck too long
      if escape-behavior = "random" [rt random 360] ; random direction for sheep
      if escape-behavior = "toward-flock" and any? sheep [ ; toward flock for dogs
        facexy mean [xcor] of sheep mean [ycor] of sheep ; face flock center
        rt (random 40 - 20) ; add random jitter
      ]
      fd escape-dist  set stuck-counter 0 ; jump forward and reset counter
    ]
  ] [set stuck-counter 0] ; reset if moved enough
  set prev-x xcor  set prev-y ycor ; store current position for next check
end

to-report angle-in-range [angle start-ang end-ang]
  ; to know if a sheep is within a dog sector when patrolling 
  report (angle >= start-ang and angle <= end-ang) ; check if angle within range
end

to-report clamp-angle [angle start-ang end-ang]
  ; to maintin a dog within its sector when patrolling 
  if angle < start-ang [report start-ang] ; clamp to minimum
  if angle > end-ang [report end-ang] ; clamp to maximum
  report angle ; return as is if within range
end

to turn-towards [target-h max-t]
  ; the sheep turn slowly towards their direction 
  let diff subtract-headings target-h heading ; angular difference
  ; turn by max amount or reach target
  ifelse abs diff < max-t [set heading target-h] [ifelse diff > 0 [rt max-t] [lt max-t]] 
end

to-report distance-between [x1 y1 x2 y2]
  report sqrt ((x2 - x1) ^ 2 + (y2 - y1) ^ 2) ; euclidean distance
end

to-report is-wall?
  ; check if patch is wall (not gate opening)
  report pxcor = gate-x and (pycor < gate-min-y or pycor > gate-max-y) 
end


; SUCCESS & MONITORS 

to check-success
  ; when to conclude the scenarios
  
  if phase = "exiting" and not any? sheep [ ; all sheep exited
    set ticks-to-success ticks ; record completion time
    set done? true ; mark simulation as complete
  ]
  if phase = "exiting" [ ; manage dog mode switching during exit
    ifelse lost-sheep > 0 [
      ask dogs with [mode = "driving"] [set mode "targeting" set target-sheep nobody] ; switch to collecting outliers
    ] [
      ask dogs with [mode = "targeting"] [set mode "driving" set target-sheep nobody] ; switch back to driving
    ]
  ]
end

to-report sheep-in-zone report count sheep with [in-containment-zone?] end ; count sheep in target zone
to-report holding-time report ifelse-value (holding-start-tick = -1) [0] [ticks - holding-start-tick] end 
to-report dogs-distance report sum [dist-traveled] of dogs end ; total distance traveled by all dogs
to-report lost-sheep  ; how many sheep are considered lost from the flock 
  if not any? sheep [report 0] ; no sheep means none lost
  let fcx mean [xcor] of sheep  let fcy mean [ycor] of sheep ; flock center
  report count sheep with [distancexy fcx fcy > lost-threshold] ; count sheep too far from center
end
to-report current-phase report phase end ; return current simulation phase
to-report sheep-captured-count report sheep-captured end ; return number of exited sheep


; METRICS
to-report flock-spreadness; variance of distances from flock center (lower = more compact)
  if count sheep < 2 [report 0]
  let fcx mean [xcor] of sheep  let fcy mean [ycor] of sheep
  report variance [distancexy fcx fcy] of sheep
end]]></code>
